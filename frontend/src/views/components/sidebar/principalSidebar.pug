//- Main admin sidebar navigation
//- Included from layouts/admin.pug
//- Expects a `currentRoute` local (string) to highlight the active link

aside.w-64.bg-gray-950.border-r.border-gray-800.flex.flex-col.h-full.hidden(class="md:flex")

  ul.flex-1.py-4.px-3.flex.flex-col.gap-1.m-0.list-none.overflow-y-auto
    li
      a.flex.items-center.gap-3.px-3.py-2.rounded-lg.text-sm.transition-colors.no-underline(
        href="/vehicles"
        class=currentRoute === "vehicles" ? "bg-primary-500/10 text-primary-400 font-medium" : "text-gray-400 hover:bg-gray-900 hover:text-gray-50 font-normal"
      )
        span.text-lg 🚗
        span Vehículos

    li
      a.flex.items-center.gap-3.px-3.py-2.rounded-lg.text-sm.transition-colors.no-underline(
        href="/zonas"
        class=currentRoute === "zonas" ? "bg-primary-500/10 text-primary-400 font-medium" : "text-gray-400 hover:bg-gray-900 hover:text-gray-50 font-normal"
      )
        span.text-lg ⬡
        span Zonas

    li.px-2.mt-4.mb-2
      span.text-xs.font-semibold.tracking-wider.uppercase.text-gray-500 Actividad

    li
      a.flex.items-center.gap-3.px-3.py-2.rounded-lg.text-sm.transition-colors.no-underline(
        href="/reservas/cancelar"
        class=currentRoute === "reservas" ? "bg-primary-500/10 text-primary-400 font-medium" : "text-gray-400 hover:bg-gray-900 hover:text-gray-50 font-normal"
      )
        span.text-lg 📋
        span Reservaciones

    li
      a.flex.items-center.gap-3.px-3.py-2.rounded-lg.text-sm.transition-colors.no-underline(
        href="/pagos"
        class=currentRoute === "pagos" ? "bg-primary-500/10 text-primary-400 font-medium" : "text-gray-400 hover:bg-gray-900 hover:text-gray-50 font-normal"
      )
        span.text-lg 💳
        span Pagos

    li
      a.flex.items-center.gap-3.px-3.py-2.rounded-lg.text-sm.transition-colors.no-underline(
        href="/reservas/historial"
        class=currentRoute === "historial" ? "bg-primary-500/10 text-primary-400 font-medium" : "text-gray-400 hover:bg-gray-900 hover:text-gray-50 font-normal"
      )
        span.text-lg 🕐
        span Historial

    li.px-2.mt-4.mb-2
      span.text-xs.font-semibold.tracking-wider.uppercase.text-gray-500 Sistema

    //- Solo visible para administradores
    if user && user.isAdmin
      li
        a.flex.items-center.gap-3.px-3.py-2.rounded-lg.text-sm.transition-colors.no-underline(
          href="/admin/usuarios"
          class=currentRoute === "usuarios" ? "bg-primary-500/10 text-primary-400 font-medium" : "text-gray-400 hover:bg-gray-900 hover:text-gray-50 font-normal"
        )
          span.text-lg 👥
          span Usuarios

    li
      a.flex.items-center.gap-3.px-3.py-2.rounded-lg.text-sm.transition-colors.no-underline(
        href="/configuracion"
        class=currentRoute === "configuracion" ? "bg-primary-500/10 text-primary-400 font-medium" : "text-gray-400 hover:bg-gray-900 hover:text-gray-50 font-normal"
      )
        span.text-lg ⚙️
        span Configuración

  if user
    .p-4.border-t.border-gray-800
      .flex.items-center.gap-3.p-2.bg-gray-900.rounded-lg
        .w-8.h-8.rounded-full.bg-gradient-to-br.from-primary-500.to-secondary-500.flex.items-center.justify-center.text-xs.font-bold.text-white.font-heading= user.name.split(" ").map(function (p) { return p.charAt(0); }).join("").slice(0, 2).toUpperCase()
        .flex-1.min-w-0
          .text-xs.font-medium.text-gray-50.truncate= user.name
          .text-xs.text-gray-400= user.role