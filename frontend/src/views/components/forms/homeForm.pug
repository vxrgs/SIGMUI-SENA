//- ── SECCIÓN 2: CÓMO FUNCIONA ─────────────────────────────────────
section#como-funciona.w-full(style="border-top: 1px solid #162438; background: #08101a; padding: 50px 0; z-index: 10; position: relative;")
  .max-w-7xl.mx-auto.px-4(class="sm:px-8")
    .text-center(style="max-width: 480px; margin: 0 auto 36px;")
      div(style="color: #1db869; font-size: 10px; font-weight: 700; text-transform: uppercase; letter-spacing: 1.5px; margin-bottom: 6px;") Proceso simple
      h2.font-display(style="font-size: clamp(22px, 4vw, 26px); font-weight: 800; color: #fff;") Estacionar nunca fue tan fácil
      p(style="font-size: 12px; color: #58718e; margin-top: 6px;") Completa tu reserva en 3 pasos antes de salir de casa.

    .grid.grid-cols-1(class="md:grid-cols-3", style="gap: 20px;")
      .feature-card(style="padding: 22px 18px; border-radius: 14px; position: relative;")
        span.font-display(style="font-size: 32px; font-weight: 800; color: rgba(43,126,201,0.2); position: absolute; top: 12px; right: 16px;") 01
        h4(style="font-size: 14px; font-weight: 700; color: #2b7ec9; margin-bottom: 8px;") 1. Elige tu zona
        p(style="font-size: 11px; color: #58718e; line-height: 1.5;") Explora el mapa y verifica la disponibilidad de celdas y tarifas por hora según tu destino[cite: 8].

      .feature-card(style="padding: 22px 18px; border-radius: 14px; position: relative;")
        span.font-display(style="font-size: 32px; font-weight: 800; color: rgba(29,184,105,0.2); position: absolute; top: 12px; right: 16px;") 02
        h4(style="font-size: 14px; font-weight: 700; color: #1db869; margin-bottom: 8px;") 2. Reserva y confirma
        p(style="font-size: 11px; color: #58718e; line-height: 1.5;") Selecciona tu vehículo registrado y confirma el horario para garantizar tu espacio sin esperas[cite: 8].

      .feature-card(style="padding: 22px 18px; border-radius: 14px; position: relative;")
        span.font-display(style="font-size: 32px; font-weight: 800; color: rgba(43,126,201,0.2); position: absolute; top: 12px; right: 16px;") 03
        h4(style="font-size: 14px; font-weight: 700; color: #2b7ec9; margin-bottom: 8px;") 3. Llega y estaciona
        p(style="font-size: 11px; color: #58718e; line-height: 1.5;") Muestra tu código de acceso digital en la entrada y disfruta de tu estadía sin preocupaciones.

//- ── SECCIÓN INTERACTIVA: COTIZADOR EN VIVO ────────────────────────
section#calculadora.w-full(style="border-top: 1px solid #162438; background: #03070b; padding: 50px 0; z-index: 10; position: relative;")
  .max-w-4xl.mx-auto.px-4(class="sm:px-8")
    .feature-card(style="padding: clamp(20px, 4vw, 30px); border-radius: 16px; border-color: rgba(29,184,105,0.3);")
      .grid.grid-cols-1(class="md:grid-cols-2", style="gap: 28px; align-items: center;")
        div
          div(style="color: #1db869; font-size: 10px; font-weight: 700; text-transform: uppercase; letter-spacing: 1.5px; margin-bottom: 6px;") Cotizador interactivo
          h3.font-display(style="font-size: clamp(20px, 3.5vw, 22px); font-weight: 800; color: #fff;") Calcula el costo de tu estadía
          p(style="font-size: 11px; color: #58718e; margin-top: 6px; line-height: 1.5;") Ajusta la zona y las horas estimadas para conocer el total antes de confirmar.
        
        div.space-y-4
          div
            label(style="font-size: 11px; font-weight: 600; color: #cbd5e1; display: block; margin-bottom: 6px;") Selecciona la Zona:
            select#calcZone(onchange="calculateTotal()", style="width: 100%; padding: 10px 12px; background: #0a111b; border: 1px solid #162438; border-radius: 8px; color: #fff; font-size: 12px; outline: none;")
              option(value="2500") Zona Centro A ($2.500/h)
              option(value="3000") Zona Norte B ($3.000/h)
              option(value="2000") Zona Sur C ($2.000/h)
              option(value="2800") Zona Occidental D ($2.800/h)

          div
            .flex.justify-between(style="font-size: 11px; color: #cbd5e1; margin-bottom: 6px;")
              span Horas estimadas:
              span#calcHoursText.font-mono(style="color: #1db869; font-weight: 700;") 2 horas
            input#calcHours(type="range", min="1", max="12", value="2", oninput="calculateTotal()", style="width: 100%; accent-color: #1db869; cursor: pointer; height: 6px;")

          div(style="border-top: 1px solid #162438; padding-top: 12px; display: flex; justify-content: space-between; align-items: center;")
            span(style="font-size: 12px; color: #58718e;") Total estimado:
            span#calcTotal.font-mono(style="font-size: clamp(18px, 4vw, 22px); font-weight: 800; color: #1db869;") $5.000 COP

          button.btn-gradient(onclick="goToBookingWithEstimate()", style="width: 100%; padding: 11px 0; border: none; border-radius: 8px; font-size: 12px; cursor: pointer;") Reservar con esta tarifa

//- ── SECCIÓN ZONAS ACTIVAS ────────────────────────────────────────
