//- Toast emergente interactivo
#toastBox
  span(style="width:8px; height:8px; background:#1db869; border-radius:50%; box-shadow:0 0 8px #1db869; flex-shrink: 0;")
  div
    h5#toastTitle(style="font-size: 11px; font-weight: 700; color: #fff;") Notificación PARKALIA
    p#toastMsg(style="font-size: 10px; color: #58718e;") Acción completada con éxito.

//- Canvas de partículas de fondo
canvas#bgCanvas(style="position: fixed; inset: 0; pointer-events: none; z-index: 1;")

//- ── HEADER / NAVBAR ──────────────────────────────────────────────
header#mainHeader.w-full.sticky.top-0.z-50(style="border-bottom: 1px solid #162438; background: rgba(3, 7, 11, 0.92); backdrop-filter: blur(16px);")
  .max-w-7xl.mx-auto.px-4(class="sm:px-8", style="height: 68px; display: flex; align-items: center; justify-content: space-between;")

    a.logo-brand(href="#inicio", onclick="scrollToTop(event)")
      img.logo-img-main(src="/img/parkalia.png", alt="PARKALIA")

    nav#desktopNav.hidden(class="md:flex", style="align-items: center; gap: 24px;")
      a.nav-item.active(href="#inicio", data-section="inicio") Inicio
      a.nav-item(href="#caracteristicas", data-section="caracteristicas") Características
      a.nav-item(href="#como-funciona", data-section="como-funciona") Cómo funciona
      a.nav-item(href="#calculadora", data-section="calculadora") Cotizador
      a.nav-item(href="#zonas", data-section="zonas") Zonas en vivo
      a.nav-item(href="#faq", data-section="faq") Preguntas

    .hidden(class="md:flex", style="align-items: center; gap: 12px;")
      a.btn-outline-cyber(href="/auth/login", style="font-size: 12px; font-weight: 500; padding: 7px 16px; border-radius: 8px;") Iniciar sesión
      a.btn-gradient(href="/auth/register", style="font-size: 12px; padding: 7px 20px; border-radius: 8px;") Registrarse

    button.block(class="md:hidden", onclick="toggleMobileMenu()", aria-label="Abrir menú", style="background:none; border:none; color:#1db869; font-size:24px; cursor:pointer; padding: 4px;") ☰

//- ── MENÚ MÓVIL ───────────────────────────────────────────────────
#mobileMenu.fixed.top-0.right-0.h-full.p-6.z-50.border-l.border-gray-800.shadow-2xl.flex.flex-col.justify-between(style="display: flex; background: #03070b;")
  div
    .flex.justify-between.items-center.mb-8
      img(src="/img/parkalia.png", alt="PARKALIA", style="height: 28px; width: auto; object-fit: contain;")
      button(onclick="toggleMobileMenu()", aria-label="Cerrar menú", style="color:#58718e; font-size:22px; background:none; border:none; cursor:pointer; padding: 4px;") ✕
    nav.flex.flex-col.gap-5
      a(href="#inicio", onclick="toggleMobileMenu()", style="font-size: 14px; font-weight: 600; color: #1db869;") Inicio
      a(href="#caracteristicas", onclick="toggleMobileMenu()", style="font-size: 14px; color: #cbd5e1;") Características
      a(href="#como-funciona", onclick="toggleMobileMenu()", style="font-size: 14px; color: #cbd5e1;") Cómo funciona
      a(href="#calculadora", onclick="toggleMobileMenu()", style="font-size: 14px; color: #cbd5e1;") Cotizador
      a(href="#zonas", onclick="toggleMobileMenu()", style="font-size: 14px; color: #cbd5e1;") Zonas en vivo
      a(href="#faq", onclick="toggleMobileMenu()", style="font-size: 14px; color: #cbd5e1;") Preguntas
  div.flex.flex-col.gap-3
    a.btn-outline-cyber.text-center(href="/auth/login", style="padding: 10px; border-radius: 8px; font-size: 12px; font-weight: 600;") Iniciar sesión
    a.btn-gradient.text-center(href="/auth/register", style="padding: 10px; border-radius: 8px; font-size: 12px; font-weight: 700;") Registrarse

//- ── HERO PRINCIPAL ────────────────────────────────────────────────
main#inicio.relative.flex-1.hero-bg.flex.items-center(style="min-height: 520px; z-index: 10; padding: 36px 0;")
  .max-w-7xl.mx-auto.px-4(class="sm:px-8", style="width: 100%;")
    .grid.grid-cols-1(class="lg:grid-cols-12", style="gap: 36px; align-items: center;")

      //- Izquierda: Contenido
      div(class="lg:col-span-7 text-center lg:text-left flex flex-col items-center lg:items-start", style="max-width: 560px; margin: 0 auto;")
        div(style="display: inline-flex; align-items: center; gap: 8px; padding: 5px 12px; border-radius: 9999px; background: #071a1c; border: 1px solid #0e3d36; color: #10b981; font-size: 10px; font-weight: 600; margin-bottom: 16px;")
          span(style="width: 6px; height: 6px; background: #10b981; border-radius: 50%; box-shadow: 0 0 10px #10b981;")
          span.font-mono SISTEMA ACTIVO // v2.6.4

        h1.font-display(style="font-size: clamp(32px, 5vw, 46px); font-weight: 800; line-height: 1.1; color: #fff; letter-spacing: -0.5px; margin-bottom: 16px;")
          | Tu espacio,
          br
          span(style="color: #2b7ec9; text-shadow: 0 0 25px rgba(43,126,201,0.35);") siempre disponible

        p(style="color: #58718e; font-size: 13px; line-height: 1.6; margin-bottom: 24px; max-width: 480px;")
          | PARKALIA es un ecosistema inteligente de movilidad urbana que te permite reservar, pagar y acceder a estacionamientos en tiempo real desde tu smartphone[cite: 8].

        //- Botones Hero con presencia sólida y ergonomía táctil
        .hero-buttons-container.flex.flex-col(style="gap: 14px; width: 100%; max-width: 440px; margin-top: 6px;")
          a.hero-btn-primary(href="/auth/register")
            svg(style="width: 20px; height: 20px; flex-shrink: 0;", viewBox="0 0 24 24", fill="none", stroke="currentColor", stroke-width="2.3")
              path(d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2")
              circle(cx="9", cy="7", r="4")
              line(x1="19", x2="19", y1="8", y2="14")
              line(x1="22", x2="16", y1="11", y2="11")
            span Registrarse Ahora
          
          a.hero-btn-secondary(href="#zonas")
            svg(style="width: 20px; height: 20px; color: #38bdf8; flex-shrink: 0;", viewBox="0 0 24 24", fill="none", stroke="currentColor", stroke-width="2.3")
              circle(cx="12", cy="12", r="10")
              polygon(points="12 8 8 12 12 16 12 8")
            span Explorar Radar

      //- Derecha: Mockup 3D
      .flex.justify-center.items-center.relative.perspective-scene(class="lg:col-span-5", style="margin-top: 20px;")
        .card-back-cyan(style="position: absolute; border-radius: 36px; opacity: 0.8; pointer-events: none; background: #2b7ec9;")
        .card-back-mint(style="position: absolute; border-radius: 36px; opacity: 0.85; pointer-events: none; background: #1db869;")

        #interactivePhone(style="position: relative; border-radius: 40px; overflow: hidden; padding: 6px; display: flex; flex-direction: column;")
          div(style="width: 100%; height: 100%; background: #0c1624; border-radius: 30px; overflow: hidden; display: flex; flex-direction: column; justify-content: space-between; color: #f1f5f9; position: relative; border: 1px solid rgba(255,255,255,0.08); box-shadow: inset 0 2px 8px rgba(0,0,0,0.6);")
            
            // Status bar
            div(style="padding: 9px 16px 3px; display: flex; justify-content: space-between; align-items: center; font-size: 9px; font-weight: 700; color: #738ca6; background: rgba(12,22,36,0.9);")
              span.font-mono#liveClock 09:41
              div(style="width: 44px; height: 6px; background: #060b12; border-radius: 9999px; border: 1px solid rgba(255,255,255,0.05);")
              span.font-mono(style="color: #1db869;") 5G 100%

            // App Topbar
            div(style="padding: 7px 14px; display: flex; justify-content: space-between; align-items: center; border-bottom: 1px solid rgba(34, 53, 77, 0.7); background: rgba(15, 27, 43, 0.6);")
              button(onclick="showToast('Menú Móvil', 'Inicia sesión para ver tu panel personal')", style="background:none; border:none; color:#2b7ec9; font-size:13px; cursor:pointer;") ☰
              img.logo-img-phone(src="/img/parkalia.png", alt="PARKALIA")
              button(onclick="showToast('Ajustes', 'Configuración de geolocalización activa')", style="background:none; border:none; color:#738ca6; font-size:11px; cursor:pointer;") ⚙

            // Mapa Interactivo
            div(style="flex: 1; margin: 4px 6px; background: #08101a; border-radius: 16px; position: relative; overflow: hidden; border: 1px solid #1a293d;")
              svg(style="position: absolute; inset: 0; width: 100%; height: 100%; opacity: 0.9;", xmlns="http://www.w3.org/2000/svg")
                line(x1="0", y1="45", x2="300", y2="80", stroke="#17263c", stroke-width="11")
                line(x1="70", y1="0", x2="105", y2="400", stroke="#17263c", stroke-width="13")
                line(x1="0", y1="160", x2="300", y2="135", stroke="#17263c", stroke-width="15")
                line(x1="190", y1="0", x2="160", y2="400", stroke="#17263c", stroke-width="10")
                rect(x="10", y="70", width="50", height="60", rx="6", fill="#092823", stroke="#0f4a41", stroke-width="1")
                rect(x="170", y="165", width="50", height="50", rx="6", fill="#092823", stroke="#0f4a41", stroke-width="1")

              div(style="position: absolute; top: 45%; left: 50%; transform: translate(-50%, -50%); width: 100px; height: 100px; background: rgba(43,126,201,0.15); border: 1px solid rgba(29,184,105,0.4); border-radius: 50%; display: flex; align-items: center; justify-content: center; pointer-events: none;")
                div(style="width: 8px; height: 8px; background: #2b7ec9; border-radius: 50%; box-shadow: 0 0 0 3px #1db869;")

              .pin-pulse#pinCentro(onclick="updateMockup('Zona Centro A', 'Calle 15 #8-20', 14, '$2.500/h', 'centro-a')", style="position: absolute; top: 22px; left: 32px; width: 20px; height: 20px; background: #2b7ec9; color: #fff; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 9px; font-weight: 800; z-index: 5; box-shadow: 0 0 12px rgba(43,126,201,0.7);") P
              .pin-pulse#pinNorte(onclick="updateMockup('Zona Norte B', 'Carrera 10 #24-45', 3, '$3.000/h', 'norte-b')", style="position: absolute; top: 50px; right: 28px; width: 20px; height: 20px; background: #1db869; color: #03070b; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 9px; font-weight: 800; z-index: 5; box-shadow: 0 0 12px rgba(29,184,105,0.7);") P
              .pin-pulse#pinSur(onclick="updateMockup('Zona Sur C', 'Calle 80 #12-10', 12, '$2.000/h', 'sur-c')", style="position: absolute; bottom: 24px; left: 42px; width: 20px; height: 20px; background: #2b7ec9; color: #fff; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 9px; font-weight: 800; z-index: 5; box-shadow: 0 0 12px rgba(43,126,201,0.7);") P

            // Tarjeta inferior de reserva
            div(style="margin: 4px 6px 6px; background: #0f1c2d; border-radius: 14px; padding: 11px; box-shadow: 0 8px 24px rgba(0,0,0,0.6); border: 1px solid #1e334d;")
              div(style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 4px;")
                div
                  div#mkTitle(style="font-size: 11px; font-weight: 800; color: #ffffff;") Zona Centro A
                  div#mkAddress(style="font-size: 9px; color: #738ca6;") Calle 15 #8-20
                span#mkPrice.font-mono(style="font-size: 9px; font-weight: 700; padding: 2px 7px; border-radius: 9999px; background: #082420; color: #10b981; border: 1px solid #0f4a41;") $2.500/h

              div(style="font-size: 9px; font-weight: 600; color: #9bb1c8; margin-bottom: 7px; display: flex; align-items: center; gap: 5px;")
                span(style="width: 5px; height: 5px; background: #1db869; border-radius: 50%; box-shadow: 0 0 6px #1db869;")
                span#mkSpots 14 espacios disponibles

              button#btnReserveDemo.btn-gradient(onclick="executePhoneBooking()", style="width: 100%; padding: 7px 0; border: none; border-radius: 7px; font-size: 10px; cursor: pointer;") Confirmar Reserva

//- ── 4 CARACTERÍSTICAS INFERIORES ─────────────────────────────────
