      div
        div(style="color: #1db869; font-size: 10px; font-weight: 700; text-transform: uppercase; letter-spacing: 1.5px; margin-bottom: 6px;") Red satelital
        h2.font-display(style="font-size: clamp(22px, 4vw, 26px); font-weight: 800; color: #fff;") Zonas de Parqueo Habilitadas
      a.btn-gradient(href="/zonas", style="font-size: 11px; padding: 8px 18px; border-radius: 8px; text-decoration: none; align-self: flex-start;") Ver mapa completo

    .grid.grid-cols-1(class="sm:grid-cols-2 lg:grid-cols-4", style="gap: 16px;")
      .feature-card(style="padding: 16px; border-radius: 12px; display: flex; flex-direction: column; justify-content: space-between;")
        div
          .flex.justify-between.items-start(style="margin-bottom: 8px;")
