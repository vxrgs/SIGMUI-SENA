extends ../../layouts/auth.pug

block content
  div(class="relative min-h-screen w-full flex flex-col items-center justify-center bg-[#080C10] overflow-hidden px-4 py-8 select-none")

    // Círculo Azul (Izquierda)
    div(class="absolute top-1/2 left-1/2 -translate-y-1/2 -translate-x-[85%] w-[640px] h-[640px] lg:w-[700px] lg:h-[700px] rounded-full bg-[#0d223a] pointer-events-none z-0")

    // Círculo Verde (Derecha)
    div(class="absolute top-1/2 left-1/2 -translate-y-1/2 -translate-x-[15%] w-[640px] h-[640px] lg:w-[700px] lg:h-[700px] rounded-full bg-[#0a2a1c] pointer-events-none z-0")

    // Contenido Central
    div(class="relative z-10 w-full flex flex-col items-center max-w-[480px]")
      
      // Logo Parkalia
      div(class="mb-7 flex justify-center")
        img(
          src="/img/parkalia.png" 
          alt="PARKALIA" 
          class="h-11 w-auto object-contain"
        )

      // Pantalla del Formulario
      div#screen-form
        include ../../components/forms/registerForm.pug

      // Pantalla de Éxito (oculta por defecto)
      div#screen-success(class="hidden w-full p-8 rounded-[16px] bg-[#141B27] border border-[#1E2A3A] shadow-2xl text-center")
        div(class="mb-4")
          svg(class="w-16 h-16 mx-auto text-[#3DBE6C]" fill="none" stroke="currentColor" viewBox="0 0 24 24")
            path(stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z")
        h2(class="text-xl font-bold text-[#E8EDF5] mb-2") ¡Cuenta creada exitosamente!
        p(class="text-[#5A6A7E] text-sm mb-1") Se ha enviado un correo de confirmación a:
        p#success-email-display(class="text-[#1A6FD4] font-medium text-sm mb-6")
        a(href="/auth/login" class="inline-block px-6 py-3 bg-gradient-to-r from-[#1A6FD4] to-[#3DBE6C] rounded-lg text-white text-[14px] font-medium transition-opacity hover:opacity-90") Iniciar sesión

    script(src="/js/pages/register.js")