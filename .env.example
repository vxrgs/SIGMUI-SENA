# --- Base de datos ---
# Deja DB_HOST y DB_NAME vacios para usar SQLite local (data/sigmui.sqlite).
# Con ambos definidos se usa MySQL.
DB_HOST=
DB_NAME=
DB_PASS=
DB_PORT=
DB_USER=
# safe = solo crea tablas que falten | alter = ajusta tablas existentes a los modelos
DB_SYNC=safe
# Ruta opcional del archivo SQLite
DB_STORAGE=

# --- Aplicacion ---
NODE_ENV=development
PORT=3000
# OBLIGATORIO en produccion: cadena larga y aleatoria
JWT_SECRET=

# Primer administrador (util en produccion, donde no se crean cuentas demo)
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=

EMAIL_HOST=
EMAIL_PASS=
EMAIL_PORT=
EMAIL_USER=

