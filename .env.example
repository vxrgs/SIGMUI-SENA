# Copy this file to .env and fill in the values. NEVER commit .env to Git.

# --- Database ---
# Leave DB_HOST and DB_NAME empty to use local SQLite (data/sigmui.sqlite).
# With both set, MySQL is used.
DB_HOST=
DB_NAME=
DB_PASS=
DB_PORT=3306
DB_USER=
# safe = only create missing tables | alter = adjust existing tables to the models
DB_SYNC=safe
# Optional SQLite file path
DB_STORAGE=

# --- Application ---
NODE_ENV=development
PORT=3000
# REQUIRED in production: a long, random string
JWT_SECRET=

# First administrator (useful in production, where demo accounts are not created)
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=

# --- Email (SMTP) ---
EMAIL_HOST=
EMAIL_PORT=
EMAIL_USER=
EMAIL_PASS=
